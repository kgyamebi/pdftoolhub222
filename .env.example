# Public site
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127

# Database (optional — not required for core browser tools)
DATABASE_URL=postgres://user:pass@localhost:5432/pdfhub

# Object storage (optional server processing)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Auth (optional — tools work without an account)
AUTH_SECRET=replace-me
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = personal Microsoft + school 365 / Azure AD
MICROSOFT_TENANT_ID=common

# Payments (leave empty to use the mock provider)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# AI (optional — extractive summarize/ask still work without this)
AI_API_KEY=
AI_PROVIDER=openai
NEXT_PUBLIC_AI_ENABLED=false

# Email / analytics
EMAIL_PROVIDER=console
EMAIL_FROM="PDF Tools Hub <noreply@localhost>"
RESEND_API_KEY=
EMAIL_API_KEY=
ANALYTICS_WRITE_KEY=
NEXT_PUBLIC_ADS_ENABLED=false
