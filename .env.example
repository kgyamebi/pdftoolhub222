# Public site
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127

# Database (optional — not required for core browser tools)
DATABASE_URL=postgres://user:pass@localhost:5432/pdfhub

# Object storage (optional server processing)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Auth
AUTH_SECRET=replace-me
ADMIN_PASSWORD=

# Payments (leave empty to use the mock provider)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# AI (optional — extractive summarize/ask still work without this)
AI_API_KEY=
AI_PROVIDER=openai
NEXT_PUBLIC_AI_ENABLED=false

# Email / analytics
EMAIL_PROVIDER=
EMAIL_API_KEY=
ANALYTICS_WRITE_KEY=
NEXT_PUBLIC_ADS_ENABLED=false
